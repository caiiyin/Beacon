# ─── AI 서비스 API 키 ───────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# ─── Mock 모드 제어 ─────────────────────────────────────────────
# true 이면 실제 API 호출 없이 가짜 응답 반환 (API 키 없어도 실행 가능)
USE_MOCK_AI=true

# ─── 데이터베이스 ───────────────────────────────────────────────
DATABASE_URL=sqlite:///./beacon.db

# ─── CORS 설정 ──────────────────────────────────────────────────
# 데모/배포 시: * (전체 허용) — cloudflared URL이 매번 바뀌므로 편리
# 운영 시: https://your-domain.com,https://other-domain.com (콤마 구분)
CORS_ORIGINS=*

# ─── 서버 설정 ──────────────────────────────────────────────────
BACKEND_PORT=8000
